#: kivy 1.0.9

<HikingApp>:
    canvas:
        Rectangle:
            pos: self.centre_x -5,0
            size:10, self.height

<TabBar>:
    do_default_tab: False
    tab_width: self.width / 5  

    TabbedPanelItem:
        text: 'Home'
        Home:

    TabbedPanelItem:
        text: 'Add Climb'
        AddClimbs:       

    TabbedPanelItem:
        text: 'Mountains'
        Mountains:

    TabbedPanelItem:
        text: 'Climbs'
        Climbs:

    TabbedPanelItem:
        text: 'Statistics'
        Statistics:


<Climbs>:
    BoxLayout:
        orientation: "vertical"

        ScrollView:
            do_scroll_x: False

            BoxLayout:
                id: climb_list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height

<AddClimbs>:
    BoxLayout:
        orientation: "vertical"

        TextInput:
            id: mountain_search
            hint_text: "Search for a mountain"
            on_text: root.search_mountains(self.text)

        BoxLayout:
            id: mountain_results
            orientation: "vertical"

        Label:
            id: selected_mountain
            text: "No mountain selected"

        TextInput:
            id: date_climbed
            hint_text: "Date climbed"

        TextInput:
            id: time_climbed
            hint_text: "Time climbed"

        Button:
            text: "Add Climb"
            on_release: root.add_climb_from_form()

<Mountains>:
    BoxLayout:
        orientation: "vertical"

        ScrollView:
            do_scroll_x: False

            BoxLayout:
                id: mountain_list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
